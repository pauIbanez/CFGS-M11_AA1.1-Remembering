{
  "folders": [
    {
      "name": "Unity",
      "path": "..",
    },
    {
      "name": "Scripts",
      "path": "../Assets/Scripts",
    },
  ],

  // ─────────────────────────────────────────────
  //  SETTINGS
  // ─────────────────────────────────────────────
  "settings": {
    // ── C# / Unity language support ──────────────
    "dotnet-test-explorer.testProjectPath": "**/*.Tests.csproj",
    "omnisharp.enableRoslynAnalyzers": true,
    "omnisharp.enableEditorConfigSupport": true,
    "omnisharp.useModernNet": false,
    "csharp.suppressDotnetInstallWarning": true,
    "csharp.suppressDotnetRestoreNotification": true,

    // ── Editor behaviour ─────────────────────────
    "editor.defaultFormatter": "ms-dotnettools.csharp",

    // ── File nesting (keeps Explorer tidy) ───────
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.cs": "${capture}.cs.meta",
      "*.unity": "${capture}.unity.meta",
      "*.prefab": "${capture}.prefab.meta",
      "*.asset": "${capture}.asset.meta",
      "*.mat": "${capture}.mat.meta",
      "*.anim": "${capture}.anim.meta",
      "*.controller": "${capture}.controller.meta",
      "*.shader": "${capture}.shader.meta",
      "*.png": "${capture}.png.meta",
      "*.jpg": "${capture}.jpg.meta",
      "*.fbx": "${capture}.fbx.meta",
      "*.obj": "${capture}.obj.meta",
      "*.wav": "${capture}.wav.meta",
      "*.mp3": "${capture}.mp3.meta",
      "*.ogg": "${capture}.ogg.meta",
      "*.mp4": "${capture}.mp4.meta",
      "*.ttf": "${capture}.ttf.meta",
      "*.otf": "${capture}.otf.meta",
    },

    // ── File associations ─────────────────────────
    "files.associations": {
      // Unity text-based formats
      "*.unity": "yaml",
      "*.prefab": "yaml",
      "*.asset": "yaml",
      "*.meta": "yaml",
      "*.mat": "yaml",
      "*.anim": "yaml",
      "*.controller": "yaml",
      "*.overrideController": "yaml",
      "*.physicMaterial": "yaml",
      "*.physicsMaterial2D": "yaml",
      "*.playable": "yaml",
      "*.mask": "yaml",
      "*.brush": "yaml",
      "*.flare": "yaml",
      "*.fontsettings": "yaml",
      "*.guiskin": "yaml",
      "*.renderTexture": "yaml",
      "*.spriteatlas": "yaml",
      "*.terrainlayer": "yaml",
      "*.mixer": "yaml",
      // Shader variants
      "*.cginc": "hlsl",
      "*.hlsl": "hlsl",
      "*.glsl": "glsl",
      "*.shader": "shaderlab",
      "*.compute": "hlsl",
      // Misc
      "*.asmdef": "json",
      "*.asmref": "json",
      "*.inputactions": "json",
      "*.json": "json",
      "*.rsp": "text",
      "*.editorconfig": "ini",
    },

    // ── Files to exclude from Explorer ───────────
    "files.exclude": {
      // Unity generated folders
      "Library/": true,
      "Temp/": true,
      "Obj/": true,
      "Build/": true,
      "Builds/": true,
      "Logs/": true,
      "UserSettings/": true,
      "MemoryCaptures/": true,
      // VS / Rider project files (generated by Unity)
      "*.sln": true,
      "*.csproj": true,
      // macOS junk
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      // JetBrains
      "**/.idea/": true,
      // VS Code local (keep .vscode itself visible for team reference)
      "**/.vs/": true,
      "**/*.meta": true,
    },

    // ── Search exclusions (faster greps) ─────────
    "search.exclude": {
      "Library/": true,
      "Temp/": true,
      "Obj/": true,
      "Build/": true,
      "Builds/": true,
      "Logs/": true,
      "*.sln": true,
      "*.csproj": true,
      "**/.git/": true,
      "**/.idea/": true,
      "**/.vs/": true,
      "**/node_modules/": true,
    },

    // ── Watcher exclusions (reduce CPU hammering) ─
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/Library/**": true,
      "**/Temp/**": true,
      "**/Obj/**": true,
      "**/Builds/**": true,
      "**/Logs/**": true,
      "**/node_modules/**": true,
    },

    // ── Git ───────────────────────────────────────
    "git.ignoreLimitWarning": true,
    "dotnet.formatting.organizeImportsOnFormat": true,
  }, // end settings

  // ─────────────────────────────────────────────
  //  EXTENSIONS  (recommendations shown on open)
  // ─────────────────────────────────────────────
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp", // C# language support
      "ms-dotnettools.csdevkit", // C# Dev Kit (optional but nice)
      "visualstudiotoolsforunity.vstuc", // Unity Tools for VS Code (official)
      "editorconfig.editorconfig", // Respect .editorconfig
      "eamodio.gitlens", // Git superpowers
      "streetsidesoftware.code-spell-checker", // Catch typos in comments
      "oderwat.indent-rainbow", // Visualise indentation (handy for YAML)
    ],
    "unwantedRecommendations": [],
  },
}
